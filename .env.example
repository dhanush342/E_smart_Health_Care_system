# E-Health-Care Environment Variables Template
# Copy this file to .env and populate with your production secrets.

# Django Security
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Email Credentials
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password

# Rate Limiting Configuration
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900
GLOBAL_RATE_LIMIT=120
GLOBAL_RATE_WINDOW_SECONDS=60

# Payload and Upload Limits (in bytes: 1MB body, 10MB file upload)
MAX_BODY_SIZE_BYTES=1048576
MAX_UPLOAD_SIZE_BYTES=10485760

# Seeding Defaults
DEFAULT_SEED_DOCTOR_PASSWORD=change_this_default_seed_password
